package Day1;

public class Maximum {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
			        int a[] = {10, 40, 30, 50, 20};

			        int max = a[0];

			        for (int i = 1; i < a.length; i++) {
			            if (a[i] > max) {
			                max = a[i];
			            }
			        }

			        System.out.println("Maximum Element = " + max);
			    }
			}
